# ---------------------------------------------------------------------------
# Insight Dashboard - variables de entorno
# Copia este archivo como `.env` (o `.env.local`) y ajusta los valores.
# Vite sólo expone al cliente las variables con prefijo VITE_.
# NUNCA coloques aquí secretos reales: todo lo que empiece por VITE_ termina
# incrustado en el bundle público.
# ---------------------------------------------------------------------------

# Título mostrado en el header y en la pestaña del navegador
VITE_APP_TITLE=Insight Dashboard

# Modo de la capa de datos: mock | rest | graphql | firebase | aws-api-gateway
# `mock` es el único que funciona sin backend. El resto son puntos de
# integración ya cableados en src/services/repositories.
VITE_DATA_SOURCE_MODE=mock

# Endpoints de los distintos modos (sólo se usan si el modo corresponde)
VITE_API_BASE_URL=https://api.example.com/v1
VITE_GRAPHQL_ENDPOINT=https://api.example.com/graphql
VITE_AWS_API_GATEWAY_URL=https://abc123.execute-api.us-east-1.amazonaws.com/prod

# Firebase (valores públicos de cliente; las reglas de seguridad viven en Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# OAuth: sólo los client id públicos. El client secret vive en el backend.
VITE_OAUTH_GOOGLE_CLIENT_ID=
VITE_OAUTH_GITHUB_CLIENT_ID=

# Latencia artificial de los mocks en milisegundos (para probar skeletons)
VITE_MOCK_LATENCY_MS=600

# Probabilidad de error simulado en los mocks, entre 0 y 1 (0 = nunca falla)
VITE_MOCK_ERROR_RATE=0
