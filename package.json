{
  "name": "insight-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts,.tsx,.js --fix",
    "lint:check": "eslint . --ext .vue,.ts,.tsx,.js",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,css,json,md}\""
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@vueuse/core": "^15.0.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-echarts": "^8.3.0",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
